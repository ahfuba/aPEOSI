10 REM TASKMAN.BAS: A TASK MANAGER WRITTEN IN aPE-BASIC
20 PRINT "BOARD: "; BOARD$
30 PRINT "CPU:   "; CPU$; " @ "; CPUHZ; " HZ"
40 PRINT "RAM:   "; RAM$; ", "; RAMSIZE; " BYTES ("; FREEMEM; " FREE)"
50 PRINT
60 PRINT "STARTING TWO COUNTERS..."
70 A = SPAWN("counter 50")
80 B = SPAWN("counter 200")
90 FOR T = 1 TO 3
100 SLEEP 1
110 PRINT
120 PRINT "TICK "; TICK; ", "; NPROC; " PROCESSES:"
130 PRINT "  PID", "NAME", "STATE", "RUNS"
140 FOR S = 0 TO 15
150 P = PSLOT(S)
160 IF P = 0 THEN 180
170 PRINT "  "; P, PNAME$(P), PSTATE(P), PRUNS(P)
180 NEXT S
190 NEXT T
200 KILL A : KILL B
210 YIELD
220 PRINT "KILLED "; A; " AND "; B; ". "; FREEMEM; " BYTES FREE AGAIN."
