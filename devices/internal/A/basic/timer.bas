10 REM TIMER.BAS: PROGRAM THE aPE-T1 TIMER IN SOCKET BUS0
20 REM REGISTERS: CTRL=T+0 STATUS=T+1 LOAD=T+4 COUNT=T+8 FIRES=T+12
30 T = IOBASE("bus0")
40 IF T < 0 THEN PRINT "NO DEVICE IN BUS0." : END
50 OUT T + 4, 250 : REM LOAD: 250 TICKS = 0.25 S AT 1000 HZ
60 OUT T, 7 : REM CTRL: ENABLE + PERIODIC + IRQ_EN
70 PRINT "TIMER RUNNING: FIRES EVERY 0.25 S."
80 FOR I = 1 TO 6
90 PRINT "COUNT "; INP(T + 8), "FIRED "; INP(T + 12), "IRQS "; IRQCOUNT("bus0")
100 SLEEP 0.4
110 NEXT I
120 OUT T, 0 : REM CTRL: STOP
130 PRINT "TIMER STOPPED."
