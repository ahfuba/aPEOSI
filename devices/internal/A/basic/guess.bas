10 REM GUESS.BAS: GUESS THE NUMBER
20 RANDOMIZE
30 N = INT(RND(1) * 100) + 1
40 T = 0
50 PRINT "I'M THINKING OF A NUMBER FROM 1 TO 100."
60 INPUT "YOUR GUESS"; G
70 T = T + 1
80 IF G < N THEN PRINT "HIGHER!" : GOTO 60
90 IF G > N THEN PRINT "LOWER!" : GOTO 60
100 PRINT "YOU GOT IT IN "; T; " TRIES!"
110 INPUT "PLAY AGAIN (Y/N)"; A$
120 IF LEFT$(A$, 1) = "Y" OR LEFT$(A$, 1) = "y" THEN 30
130 PRINT "BYE!"
