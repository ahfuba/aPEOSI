10 REM SERIAL.BAS: TALK TO THE ECHO PLUG ON COM1, THROUGH THE UART IN BUS1
20 REM REGISTERS: DATA=U+0 STATUS=U+1 (1 = TX READY, 2 = RX READY) BAUD=U+4
30 U = IOBASE("bus1")
40 IF U < 0 THEN PRINT "NO UART IN BUS1." : END
50 INPUT "BAUD RATE (300-9600)"; B : OUT U + 4, B
60 INPUT "SEND WHAT"; M$
70 R$ = ""
80 FOR I = 1 TO LEN(M$)
90 IF (INP(U + 1) AND 1) = 0 THEN 90 : REM WAIT FOR THE TRANSMITTER
100 OUT U, ASC(MID$(M$, I, 1))
110 GOSUB 200
120 NEXT I
130 FOR W = 1 TO 100 : GOSUB 200 : YIELD : NEXT W
140 PRINT "SENT: "; M$
150 PRINT "ECHO: "; R$
160 END
200 IF INP(U + 1) AND 2 THEN R$ = R$ + CHR$(INP(U)) : GOTO 200
210 RETURN
